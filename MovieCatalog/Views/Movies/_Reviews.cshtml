@model MovieDetailsViewModel
@inject UserManager<AppUser> UserManager
@{
    var myId = UserManager.GetUserId(User);
}
@if (Model.Reviews.Count == 0)
{
    <div class="cv-empty">No reviews yet – be the first!</div>
}
<div class="d-grid gap-3">
    @foreach (var r in Model.Reviews)
    {
        var mine = r.UserId == myId;
        <article class="cv-review @(mine ? "mine" : "")">
            <div class="d-flex align-items-center gap-3">
                <div class="flex-grow-1">
                    <div class="fw-semibold">@r.User!.Name @if (mine) { <span class="cv-badge">You</span> }</div>
                    <div class="small text-muted">
                        @r.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                        @if (r.UpdatedAt is not null) { <span>· edited</span> }
                    </div>
                </div>
                <div class="cv-score lg">@r.Rating<span>/10</span></div>
            </div>
            @if (!string.IsNullOrWhiteSpace(r.Comment))
            {
                <p class="mt-3 mb-0">@r.Comment</p>
            }
            @if (mine)
            {
                <div class="d-flex gap-2 mt-3">
                    <a class="btn btn-sm cv-btn-ghost" asp-controller="Reviews" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                    <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@r.Id" method="post" data-confirm="Delete your review?">
                        <button class="btn btn-sm cv-btn-danger" type="submit">Delete</button>
                    </form>
                </div>
            }
        </article>
    }
</div>
