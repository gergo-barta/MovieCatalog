@model List<Person>
@{
    ViewData["Title"] = "People";
}
<div class="container cv-page">
    <div class="cv-page-head">
        <div>
            <h1>People</h1>
            <p class="text-muted mb-0">Actors, directors and writers</p>
        </div>
        @if (User.Identity?.IsAuthenticated == true) { <a class="btn cv-btn" asp-action="Create">+ Add person</a> }
    </div>

    <form method="get" class="cv-filters">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name…" />
        <button class="btn cv-btn-ghost" type="submit">Search</button>
    </form>

    <div class="cv-people">
        @foreach (var p in Model)
        {
            var roles = p.Credits.Select(c => c.Role).Distinct().OrderBy(r => r).ToList();
            <a class="cv-person" asp-action="Details" asp-route-id="@p.Id">
                <div>
                    <div class="fw-semibold">@p.FullName</div>
                    <div class="small text-muted">
                        @(roles.Count == 0 ? "No credits" : string.Join(" · ", roles)) · @p.Credits.Count credit@(p.Credits.Count == 1 ? "" : "s")
                    </div>
                </div>
            </a>
        }
    </div>
    @if (Model.Count == 0) { <div class="cv-empty">Nobody found.</div> }
</div>
