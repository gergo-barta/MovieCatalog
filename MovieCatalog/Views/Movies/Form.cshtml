@model MovieFormViewModel
@{
    var isNew = Model.Movie.Id == 0;
    var posterTitle = string.IsNullOrEmpty(Model.Movie.Title) ? "New movie" : Model.Movie.Title;
    ViewData["Title"] = isNew ? "Add movie" : $"Edit {Model.Movie.Title}";
}
<div class="container cv-page cv-narrow">
    <a class="cv-back" href="@(isNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.Movie.Id }))">&larr; Back</a>
    <h1 class="mb-4">@(isNew ? "Add a movie" : "Edit movie")</h1>

    <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Movie.Id)" method="post" enctype="multipart/form-data" class="cv-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-4">
            <div class="col-md-4">
                <label class="form-label">Poster</label>
                <div class="cv-poster mb-2" id="poster-preview">
                    <partial name="_Poster" model="new PosterModel(Model.Movie.PosterPath, posterTitle, Model.Movie.ReleaseYear)" />
                </div>
                <input asp-for="Poster" type="file" accept="image/*" class="form-control form-control-sm" />
                <span asp-validation-for="Poster" class="text-danger small"></span>
                @if (!isNew && Model.Movie.PosterPath is not null)
                {
                    <div class="form-check mt-2">
                        <input asp-for="RemovePoster" class="form-check-input" />
                        <label asp-for="RemovePoster" class="form-check-label small">Remove poster</label>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <div class="mb-3">
                    <label asp-for="Movie.Title" class="form-label"></label>
                    <input asp-for="Movie.Title" class="form-control" autofocus />
                    <span asp-validation-for="Movie.Title" class="text-danger small"></span>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Movie.ReleaseYear" class="form-label"></label>
                        <input asp-for="Movie.ReleaseYear" class="form-control" />
                        <span asp-validation-for="Movie.ReleaseYear" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Movie.DurationMinutes" class="form-label"></label>
                        <input asp-for="Movie.DurationMinutes" class="form-control" />
                        <span asp-validation-for="Movie.DurationMinutes" class="text-danger small"></span>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label asp-for="Movie.GenreId" class="form-label"></label>
                        <select asp-for="Movie.GenreId" asp-items="ViewBag.Genres" class="form-select">
                            <option value="0">Choose…</option>
                        </select>
                        <span asp-validation-for="Movie.GenreId" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Movie.StudioId" class="form-label"></label>
                        <select asp-for="Movie.StudioId" asp-items="ViewBag.Studios" class="form-select">
                            <option value="">None</option>
                        </select>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Movie.Description" class="form-label"></label>
                    <textarea asp-for="Movie.Description" rows="5" class="form-control"></textarea>
                    <span asp-validation-for="Movie.Description" class="text-danger small"></span>
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    <a class="btn cv-btn-ghost" href="@(isNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.Movie.Id }))">Cancel</a>
                    <button class="btn cv-btn" type="submit">@(isNew ? "Create movie" : "Save changes")</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // live preview of the chosen poster file
        document.getElementById("Poster").addEventListener("change", e => {
            const file = e.target.files[0];
            if (!file) return;
            document.getElementById("poster-preview").innerHTML = `<img class="cv-poster-img" src="${URL.createObjectURL(file)}" alt="preview">`;
        });
    </script>
}
