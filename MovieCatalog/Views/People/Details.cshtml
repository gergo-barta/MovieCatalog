@model Person
@{
    ViewData["Title"] = Model.FullName;
    var credits = Model.Credits.OrderByDescending(c => c.Movie!.ReleaseYear).ToList();
}
<div class="container cv-page cv-narrow">
    <a class="cv-back" asp-action="Index">&larr; People</a>
    <div class="cv-person-head">
        <div class="flex-grow-1">
            <h1 class="mb-1">@Model.FullName</h1>
            <div class="text-muted">
                @if (Model.BirthDate is not null)
                {
                    <span>Born @Model.BirthDate.Value.ToString("MMMM d, yyyy")</span>
                }
                <span>· @credits.Count credit@(credits.Count == 1 ? "" : "s")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Bio)) { <p class="mt-3 mb-0">@Model.Bio</p> }
        </div>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="d-flex gap-2">
                <a class="btn cv-btn-ghost" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" data-confirm="Delete @Model.FullName and all of their credits?">
                    <button class="btn cv-btn-danger" type="submit">Delete</button>
                </form>
            </div>
        }
    </div>

    <h2 class="mt-5 mb-3">Filmography</h2>
    <div class="cv-list">
        @foreach (var c in credits)
        {
            <a class="cv-list-item" asp-controller="Movies" asp-action="Details" asp-route-id="@c.MovieId">
                <div class="cv-thumb"><partial name="_Poster" model="new PosterModel(c.Movie!.PosterPath, c.Movie.Title, c.Movie.ReleaseYear)" /></div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">@c.Movie.Title <span class="text-muted fw-normal">(@c.Movie.ReleaseYear)</span></div>
                    <div class="small text-muted">@(c.Role == CastRole.Actor ? $"as {c.CharacterName ?? "–"}" : c.Role.ToString())</div>
                </div>
                <span class="cv-chip sm">@c.Role</span>
            </a>
        }
        @if (credits.Count == 0) { <div class="cv-empty small">No credits yet.</div> }
    </div>
</div>
