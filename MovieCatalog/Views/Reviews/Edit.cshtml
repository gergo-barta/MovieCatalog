@model Review
@{
    ViewData["Title"] = "Edit review";
}
<div class="container cv-page cv-narrow sm">
    <a class="cv-back" asp-controller="Movies" asp-action="Details" asp-route-id="@Model.MovieId">&larr; @Model.Movie?.Title</a>
    <h1 class="mb-4">Edit your review</h1>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="cv-form">
        <label class="form-label">Rating</label>
        <div class="cv-star-input" role="radiogroup">
            @for (var i = 10; i >= 1; i--)
            {
                <input type="radio" id="star@(i)" name="Rating" value="@i" checked="@(i == Model.Rating)" />
                <label for="star@(i)" title="@i/10">★</label>
            }
        </div>
        <span asp-validation-for="Rating" class="text-danger small"></span>
        <div class="mt-3 mb-3">
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Comment" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a class="btn cv-btn-ghost" asp-controller="Movies" asp-action="Details" asp-route-id="@Model.MovieId">Cancel</a>
            <button class="btn cv-btn" type="submit">Save</button>
        </div>
    </form>
</div>
