@model Person
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add person" : "Edit person";
}
<div class="container cv-page cv-narrow sm">
    <a class="cv-back" href="@(isNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">&larr; Back</a>
    <h1 class="mb-4">@ViewData["Title"]</h1>
    <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" method="post" class="cv-form">
        <div class="row g-3 mb-3">
            <div class="col-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" autofocus />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="BirthDate" class="form-label"></label>
            <input asp-for="BirthDate" class="form-control" />
            <span asp-validation-for="BirthDate" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Bio" class="form-label"></label>
            <textarea asp-for="Bio" rows="4" class="form-control"></textarea>
            <span asp-validation-for="Bio" class="text-danger small"></span>
        </div>
        <div class="d-flex gap-2 justify-content-end">
            <a class="btn cv-btn-ghost" href="@(isNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">Cancel</a>
            <button class="btn cv-btn" type="submit">@(isNew ? "Create" : "Save")</button>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
